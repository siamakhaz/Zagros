# Local-safe defaults
MCP_HOST_BIND=127.0.0.1
UI_HOST_BIND=127.0.0.1
MCP_BIND_ADDR=0.0.0.0:8789
MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# Daily source refresh inside the MCP container
ZAGROS_AUTO_REFRESH=true
ZAGROS_REFRESH_CRON=0 3 * * *
ZAGROS_DAILY_CVE_LIMIT=1000
ZAGROS_PRESERVE_RAW_SOURCES=false

# HelixDB host data directory
ZAGROS_DATA_DIR=./data

# Optional Traefik override
TRAEFIK_NETWORK=proxy_default
TRAEFIK_MCP_HOST=mcp.example.com
TRAEFIK_UI_HOST=zagros.example.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
