FROM rust:1.95-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked --bin zagros-ui

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 zagrosui
COPY --from=builder /src/target/release/zagros-ui /usr/local/bin/zagros-ui
USER zagrosui
ENV UI_PORT=8788
ENTRYPOINT ["/usr/local/bin/zagros-ui"]
