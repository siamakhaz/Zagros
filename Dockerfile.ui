FROM rust:1.95-bookworm AS builder
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY src ./src
RUN cargo build --release --locked --bin cve-ui

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 10001 cveui
COPY --from=builder /src/target/release/cve-ui /usr/local/bin/cve-ui
USER cveui
ENV UI_PORT=8788
ENTRYPOINT ["/usr/local/bin/cve-ui"]
