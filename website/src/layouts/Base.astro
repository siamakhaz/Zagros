---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Zagros — Local-first security knowledge search', description = 'Local-first BM25 search over CVE, CWE, ASVS, CAPEC and ATT&CK for humans and AI agents. Rust CLI, MCP server, HelixDB.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <div class="wrap nav-inner">
      <a class="brand mono" href={`${base}`}>
        <img src={`${base}zagros.png`} alt="Zagros logo" width="26" height="26" />
        ZAGROS <small>v0.1.0</small>
      </a>
      <nav class="nav-links">
        <a href={`${base}docs/`}>Docs</a>
        <a href={`${base}install/`}>Install</a>
        <a href={`${base}install-prompt/`}>AI install</a>
        <a href={`${base}demo/`}>Demo</a>
        <a href="https://github.com/siamakhaz/Zagros" class="nav-cta">GitHub ↗</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="wrap">
      <span class="mono">ZAGROS · Local-first security knowledge search</span>
      <span style="margin-left:auto"></span>
      <a href={`${base}docs/`}>Docs</a>
      <a href={`${base}install/`}>Install</a>
      <a href={`${base}install-prompt/`}>AI install</a>
      <a href={`${base}demo/`}>Demo</a>
      <a href="https://github.com/siamakhaz/Zagros">GitHub</a>
    </div>
  </footer>
  <script>
    document.querySelectorAll('[data-copy]').forEach((b) => {
      b.addEventListener('click', () => {
        const t = b.getAttribute('data-copy') ?? '';
        navigator.clipboard?.writeText(t);
        const orig = b.textContent;
        b.textContent = 'copied'; setTimeout(() => (b.textContent = orig), 1200);
      });
    });
  </script>
</body>
</html>
