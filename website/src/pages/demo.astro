---
import Base from '../layouts/Base.astro';
import data from '../data/sample.json';
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(data);
---
<Base title="Try a search â€” Zagros" description="Static interactive demo: BM25-style search over sample CVE + knowledge records, plus MCP tool preview.">
<div class="wrap">
  <section class="block" style="padding-top:40px">
    <div class="kicker">Try a search Â· static, offline</div>
    <h2>Static browser preview of ranking behavior.</h2>
    <p class="sub">This is a static preview — it runs 100% in your browser over a tiny sample of 8 records to illustrate how queries match. It is not a live index. The real CLI / MCP server runs the same BM25 logic over a seeded HelixDB. Try <span class="mono">xz</span>, <span class="mono">CVE-2024-3094</span>, <span class="mono">sql injection</span>, <span class="mono">credentials</span>.</p>
    <div class="demo-grid">
      <div class="searchbox">
        <input id="q" type="search" value="xz" autocomplete="off" spellcheck="false" aria-label="Search sample records" />
        <button id="go">Search</button>
      </div>
      <div class="chips" id="chips">
        <button data-q="xz">xz</button>
        <button data-q="CVE-2024-3094">exact id</button>
        <button data-q="sql injection">sql injection</button>
        <button data-q="hardcoded credentials">credentials</button>
        <button data-q="CVE-2023-4911">second CVE</button>
      </div>
      <div id="results" class="demo-grid"></div>
      <div class="note">Static demo â€” scores are illustrative. Full ranking (field weights, exact-match + phrase bonuses, <span class="mono">MIN_SCORE 1.0</span>) runs in-process in the Rust binary. Point the real thing at <span class="mono">zagros search "â€¦" --top-k 5</span> or MCP <span class="mono">search_cves</span>.</div>
    </div>
  </section>

  <section class="block">
    <div class="kicker">MCP preview</div>
    <h2>What your agent sees.</h2>
    <div class="steps">
      <div class="step"><div class="n">â†’</div><div><h3 class="mono">search_cves â€” query + top_k <button class="copy-lite" data-copy='{"tool": "search_cves", "query": "xz", "top_k": 5}'>copy</button></h3><pre class="code"><span class="cm">// POST /mcp â€” Streamable HTTP</span>
&#123;"tool": <span class="hl">"search_cves"</span>, "query": "xz", "top_k": 5&#125;
<span class="cm">// â†’ ranked hits: id, score, description, source_url</span></pre></div></div>
      <div class="step"><div class="n">â†’</div><div><h3 class="mono">get_cve â€” exact id <button class="copy-lite" data-copy='{"tool": "get_cve", "cve_id": "CVE-2024-3094"}'>copy</button></h3><pre class="code">&#123;"tool": <span class="hl">"get_cve"</span>, "cve_id": "CVE-2024-3094"&#125;</pre></div></div>
    </div>
    <div class="cta-row" style="justify-content:flex-start">
      <a class="btn btn-ghost mono" href={`${base}docs/mcp/`}>MCP reference â†’</a>
    </div>
  </section>

  <section class="block" id="investigation">
    <div class="kicker">Canonical investigation flow</div>
    <h2>From question to evidence-backed recommendation.</h2>
    <p class="sub">Example question: <span class="mono">"What does Zagros know about CVE-2024-3094, and what should I do next?"</span> The agent first checks corpus health, then retrieves the record, and keeps evidence separate from interpretation.</p>

    <div class="steps">
      <div class="step" id="evidence"><div class="n">1</div><div>
        <h3>Evidence â€” retrieve and verify</h3>
        <pre class="code"><span class="cm">index_status â†’ overall_health: healthy</span>
<span class="cm">get_cve â†’ authoritative CVE record</span>
ID: <span class="hl">CVE-2024-3094</span>
Finding: malicious code in upstream xz/liblzma 5.6.0 and 5.6.1 release tarballs
Impact stated by record: could interfere with sshd authentication in affected Linux environments
Source: CVE Program / cvelistV5
Trust tier: authoritative</pre>
        <p class="muted">Retrieved text is treated as untrusted reference data. The record ID and canonical source remain attached to the claim.</p>
      </div></div>

      <div class="step" id="analysis"><div class="n">2</div><div>
        <h3>Analysis â€” interpret without rewriting the evidence</h3>
        <pre class="code">The record supports a serious software supply-chain compromise affecting xz/liblzma release artifacts.
Zagros does <span class="hl">not</span> infer affected versions, exploitability in your environment,
or remediation status unless those facts are present in authoritative evidence.</pre>
        <p class="muted">Inference is labeled as analysis, not presented as something the source said.</p>
      </div></div>

      <div class="step" id="recommendation"><div class="n">3</div><div>
        <h3>Recommendation â€” act proportionally</h3>
        <pre class="code">1. Verify whether the affected product/version exists in your environment.
2. Confirm the current vendor advisory and CVE record.
3. Prioritize remediation if exposure and affected-version evidence match.
4. Re-run the investigation after source refresh if evidence is stale.</pre>
        <p class="muted">Zagros supplies evidence and a safe investigation structure. It does not certify compliance or autonomously remediate systems.</p>
      </div></div>
    </div>
  </section>

</div>
<script define:vars={{ payload }}>
  const docs = JSON.parse(payload);
  const q = document.getElementById('q'), go = document.getElementById('go');
  const box = document.getElementById('results');
  const tok = (s) => (s.toLowerCase().match(/[a-z0-9]+(?:-[a-z0-9]+)*/g) || []);
  function search(query) {
    const terms = tok(query); const exact = query.trim().toUpperCase();
    const out = docs.map((d) => {
      const hay = (d.id + ' ' + d.title + ' ' + d.description).toLowerCase();
      const ht = tok(hay); let s = 0;
      for (const t of terms) { const f = ht.filter((x) => x === t).length; if (f) s += (1 + Math.log(f)) * (t.startsWith('cve-') ? 6 : t.length > 5 ? 2 : 1); }
      if (exact && d.id.toUpperCase() === exact) s += 25;
      if (terms.length > 1 && terms.every((t) => hay.includes(t))) s += 4;
      return { d, s };
    }).filter((r) => r.s >= 1).sort((a, b) => b.s - a.s);
    box.innerHTML = out.length ? out.map((r) =>
      `<div class="result"><span class="score">score ${r.s.toFixed(1)}</span><div class="rid">${r.d.id} Â· ${r.d.source}</div><h3>${r.d.title}</h3><p>${r.d.description}</p></div>`
    ).join('') : `<div class="result"><h3>No hits above MIN_SCORE 1.0</h3><p class="muted">Try â€œxzâ€, â€œcredentialsâ€, or a full CVE id.</p></div>`;
  }
  go.onclick = () => search(q.value);
  q.onkeydown = (e) => { if (e.key === 'Enter') search(q.value); };
  document.getElementById('chips').onclick = (e) => { const b = e.target.closest('button'); if (!b) return; q.value = b.dataset.q; search(q.value); };
  search(q.value);
  const focus = new URLSearchParams(window.location.search).get('focus');
  if (focus) document.getElementById(focus)?.scrollIntoView({ block: 'start' });
</script>
</Base>
