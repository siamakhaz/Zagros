---
import Base from '../layouts/Base.astro';
import data from '../data/sample.json';
const base = import.meta.env.BASE_URL;
const payload = JSON.stringify(data);
---
<Base title="Try a search — Zagros" description="Static UI preview over sample CVE and knowledge fixtures, plus a real Codespaces launch path.">
<div class="wrap">
  <section class="block" style="padding-top:40px">
    <div class="kicker">UI preview · static fixture data</div>
    <h2>Preview the search interface.</h2>
    <p class="sub">This page uses 8 hand-picked fixture records to preview the UI only. It does not call HelixDB, does not run Zagros BM25, and does not show runtime scores. Use <strong>Try Zagros Live</strong> below for the real Rust retrieval engine and seeded database.</p>
    <div class="demo-grid">
      <div class="chips" id="modes">
        <button data-mode="cve">CVE sample</button>
        <button data-mode="knowledge">Knowledge sample</button>
      </div>
      <div class="searchbox">
        <input id="q" type="search" value="xz" autocomplete="off" spellcheck="false" aria-label="Filter sample records" />
        <button id="go">Filter</button>
      </div>
      <div class="chips" id="chips">
        <button data-q="xz">xz</button>
        <button data-q="CVE-2024-3094">exact id</button>
        <button data-q="sql injection">sql injection</button>
        <button data-q="hardcoded credentials">credentials</button>
        <button data-q="CVE-2023-4911">second CVE</button>
      </div>
      <div id="results" class="demo-grid"></div>
      <div class="note">Fixture preview only. Matching here is a simple browser-side text filter. Real ranking, thresholds, field weights, and exact/phrase bonuses exist only in the Rust Zagros runtime.</div>
    </div>
  </section>

  <section class="block">
    <div class="kicker">Live demo · GitHub Codespaces</div>
    <h2>Run a real Zagros instance.</h2>
    <p class="sub">Launch Zagros in your own GitHub Codespace. The dev container starts HelixDB, MCP, and the real web UI, then seeds 100 CVEs plus CWE, ASVS, CAPEC, and ATT&amp;CK. Port 8788 is forwarded privately to your GitHub account by default.</p>
    <div class="cta-row" style="justify-content:flex-start">
      <a class="btn btn-primary mono" href="https://codespaces.new/siamakhaz/Zagros?quickstart=1">Try Zagros Live →</a>
      <a class="btn btn-ghost mono" href="https://github.com/siamakhaz/Zagros/tree/main/.devcontainer">View Codespaces config →</a>
    </div>
    <div class="note">GitHub Codespaces usage is billed or quota-limited by GitHub according to your account. This launches your own disposable instance; it is not a shared public Zagros server.</div>
  </section>

  <section class="block">
    <div class="kicker">MCP preview</div>
    <h2>What your agent sees.</h2>
    <div class="steps">
      <div class="step"><div class="n">→</div><div><h3 class="mono">search_cves — real MCP tools/call request</h3><pre class="code"><span class="cm">// JSON-RPC body sent to POST /mcp</span>
&#123;
  "jsonrpc": "2.0",
  "id": 1,
  "method": <span class="hl">"tools/call"</span>,
  "params": &#123;
    "name": <span class="hl">"search_cves"</span>,
    "arguments": &#123;"query": "xz", "top_k": 5&#125;
  &#125;
&#125;</pre></div></div>
      <div class="step"><div class="n">→</div><div><h3 class="mono">get_cve — real MCP tools/call request</h3><pre class="code">&#123;
  "jsonrpc": "2.0",
  "id": 2,
  "method": <span class="hl">"tools/call"</span>,
  "params": &#123;
    "name": <span class="hl">"get_cve"</span>,
    "arguments": &#123;"cve_id": "CVE-2024-3094"&#125;
  &#125;
&#125;</pre></div></div>
    </div>
    <div class="cta-row" style="justify-content:flex-start">
      <a class="btn btn-ghost mono" href={`${base}docs/mcp/`}>MCP reference →</a>
    </div>
  </section>

  <section class="block" id="investigation">
    <div class="kicker">Example investigation flow</div>
    <h2>How an agent can use Zagros evidence.</h2>
    <p class="sub">This is a documented example, not live output from this static page. For the question <span class="mono">"What does Zagros know about CVE-2024-3094, and what should I do next?"</span>, an agent should check current corpus health, retrieve evidence, and keep its own interpretation separate.</p>

    <div class="steps">
      <div class="step" id="evidence"><div class="n">1</div><div>
        <h3>Evidence — example of fields to verify</h3>
        <pre class="code"><span class="cm">index_status → inspect current overall_health at runtime</span>
<span class="cm">get_cve → retrieve current stored CVE record</span>
ID: <span class="hl">CVE-2024-3094</span>
Finding: malicious code in upstream xz/liblzma 5.6.0 and 5.6.1 release tarballs
Impact stated by record: could interfere with sshd authentication in affected Linux environments
Source: CVE Program / cvelistV5
Trust tier: authoritative</pre>
        <p class="muted">The text above is an illustrative excerpt. In a real run, use the current <span class="mono">get_cve</span> response and its provenance/source URL.</p>
      </div></div>

      <div class="step" id="analysis"><div class="n">2</div><div>
        <h3>Agent analysis — separate from Zagros output</h3>
        <pre class="code">The record supports a serious software supply-chain compromise affecting xz/liblzma release artifacts.
Zagros does <span class="hl">not</span> infer affected versions, exploitability in your environment,
or remediation status unless those facts are present in authoritative evidence.</pre>
        <p class="muted">This interpretation is performed by the consuming agent, not generated by Zagros itself.</p>
      </div></div>

      <div class="step" id="recommendation"><div class="n">3</div><div>
        <h3>Agent recommendation — based on verified evidence</h3>
        <pre class="code">1. Verify whether the affected product/version exists in your environment.
2. Confirm the current vendor advisory and CVE record.
3. Prioritize remediation if exposure and affected-version evidence match.
4. Re-run the investigation after source refresh if evidence is stale.</pre>
        <p class="muted">These actions are an example agent workflow. Zagros supplies retrieval and provenance; it does not generate recommendations, certify compliance, or autonomously remediate systems.</p>
      </div></div>
    </div>
  </section>

</div>
<script define:vars={{ payload }}>
  const docs = JSON.parse(payload);
  const q = document.getElementById('q');
  const go = document.getElementById('go');
  const box = document.getElementById('results');
  let mode = 'cve';

  const isCve = (d) => d.id.startsWith('CVE-');
  const inMode = (d) => mode === 'cve' ? isCve(d) : !isCve(d);

  function filterRecords(query) {
    const needle = query.trim().toLowerCase();
    const out = docs.filter(inMode).filter((d) => {
      if (!needle) return true;
      return (d.id + ' ' + d.title + ' ' + d.description + ' ' + d.source)
        .toLowerCase()
        .includes(needle);
    });
    box.innerHTML = out.length ? out.map((d) =>
      `<div class="result"><div class="rid">${d.id} · ${d.source}</div><h3>${d.title}</h3><p>${d.description}</p></div>`
    ).join('') : `<div class="result"><h3>No fixture records match</h3><p class="muted">Change the filter or switch sample type.</p></div>`;
  }

  function setMode(next) {
    mode = next;
    q.value = next === 'cve' ? 'xz' : 'injection';
    filterRecords(q.value);
  }

  go.onclick = () => filterRecords(q.value);
  q.onkeydown = (e) => { if (e.key === 'Enter') filterRecords(q.value); };
  document.getElementById('chips').onclick = (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    q.value = b.dataset.q;
    filterRecords(q.value);
  };
  document.getElementById('modes').onclick = (e) => {
    const b = e.target.closest('button');
    if (!b) return;
    setMode(b.dataset.mode);
  };

  setMode('cve');
  const focus = new URLSearchParams(window.location.search).get('focus');
  if (focus) document.getElementById(focus)?.scrollIntoView({ block: 'start' });
</script>
</Base>