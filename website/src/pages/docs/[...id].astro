---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((d) => ({ params: { id: d.id.replace(/\.md$/, '') }, props: { doc: d } }));
}
const base = import.meta.env.BASE_URL;
const { doc } = Astro.props;
const { Content } = await render(doc);
const all = (await getCollection('docs')).sort((a, b) => a.id.localeCompare(b.id));
const label = (id: string) => (id.replace(/\.md$/, '').replace(/[-_]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()));
const title = doc.data.title ?? label(doc.id);
---
<Base title={`${title} — Zagros docs`}>
<div class="wrap">
  <div class="docs-layout">
    <aside class="docs-side">
      <a href={`${base}docs/`}>Overview</a>
      {all.map((d) => <a href={`${base}docs/${d.id.replace(/\.md$/, '')}/`} aria-current={d.id === doc.id ? 'page' : undefined}>{d.data.title ?? label(d.id)}</a>)}
    </aside>
    <article class="prose">
      <div class="kicker mono">{doc.id.replace(/\.md$/, '')}</div>
      <h1>{title}</h1>
      <Content />
    </article>
  </div>
</div>
</Base>
