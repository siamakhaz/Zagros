---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const docUrl = (id: string) => `${base}docs/${id.replace(/\.md$/, '')}/`;

interface NavItem { id?: string; href?: string; title: string; blurb?: string; }
interface NavGroup { title: string; items: NavItem[]; }

const navGroups: NavGroup[] = [
  {
    title: 'Start here',
    items: [
      { href: `${base}install/`, title: 'Install Zagros' },
      { id: 'deployment.md', title: 'Deploy for a team' },
      { id: 'configuration.md', title: 'Configuration' },
    ],
  },
  {
    title: 'Use Zagros',
    items: [
      { id: 'mcp.md', title: 'Connect AI agents with MCP' },
      { id: 'cli.md', title: 'CLI reference' },
      { id: 'data-sources.md', title: 'Data sources' },
      { id: 'demo.md', title: 'Investigation example' },
    ],
  },
  {
    title: 'Trust & security',
    items: [
      { id: 'source-trust-policy.md', title: 'Source trust policy' },
      { id: 'threat-model.md', title: 'Threat model' },
      { id: 'quality-metrics.md', title: 'Quality & freshness' },
      { id: 'security-review.md', title: 'Security review' },
    ],
  },
  {
    title: 'Agent integration',
    items: [
      { id: 'skill-harnesses.md', title: 'Agent harnesses' },
      { id: 'skill-contract.md', title: 'Skill contract' },
      { id: 'skill-compatibility.md', title: 'Skill compatibility' },
      { id: 'skill-trust-policy.md', title: 'Skill trust policy' },
    ],
  },
  {
    title: 'Project internals',
    items: [
      { id: 'architecture.md', title: 'Architecture' },
      { id: 'development.md', title: 'Development' },
      { id: 'testing.md', title: 'Testing' },
      { id: 'releasing.md', title: 'Releasing' },
      { id: 'interface-status.md', title: 'Interface status' },
      { id: 'vision.md', title: 'Project vision' },
    ],
  },
];

const hrefFor = (item: NavItem) => item.href ?? docUrl(item.id!);

const journeys = [
  { tag: 'TEAM', title: 'Deploy Zagros for a team', blurb: 'Run one shared instance, keep HelixDB private, and put MCP/UI behind your organization’s access boundary.', href: docUrl('deployment.md') },
  { tag: 'AI', title: 'Connect an AI agent', blurb: 'Use MCP so agents and internal tools can query the same team-controlled security reference.', href: docUrl('mcp.md') },
  { tag: 'TRUST', title: 'Understand what to trust', blurb: 'See how Zagros treats authoritative sources, provenance, freshness, and conflicting evidence.', href: docUrl('source-trust-policy.md') },
  { tag: 'OPERATE', title: 'Operate and keep it fresh', blurb: 'Configure refresh behavior, runtime settings, and health checks for a shared deployment.', href: docUrl('configuration.md') },
];
---
<Base title="Docs — Zagros" description="Zagros documentation organized by task: deploy a shared instance, connect AI agents, operate the service, and understand its trust model.">
<div class="wrap">
  <div class="docs-layout">
    <aside class="docs-side">
      <a href={`${base}docs/`} aria-current="page">Overview</a>
      {navGroups.map((group) => (
        <div class="docs-nav-group">
          <div class="docs-nav-title">{group.title}</div>
          {group.items.map((item) => <a href={hrefFor(item)}>{item.title}</a>)}
        </div>
      ))}
    </aside>

    <article class="prose docs-home">
      <div class="kicker">Documentation</div>
      <h1>What are you trying to do?</h1>
      <p class="docs-intro">Zagros is designed as a shared, self-hosted security reference for teams and their AI agents. Start with the task you need to complete; implementation details and project internals are kept lower in the navigation.</p>

      <div class="docs-journey-grid">
        {journeys.map((j) => (
          <a class="card docs-journey" href={j.href}>
            <span class="tag mono">{j.tag}</span>
            <h3>{j.title}</h3>
            <p>{j.blurb}</p>
            <span class="docs-card-link">Open guide →</span>
          </a>
        ))}
      </div>

      <section class="docs-section">
        <div class="kicker">New installation</div>
        <h2>Start with a working instance</h2>
        <p>For a first deployment, use the installation guide. If you want an AI agent to perform the setup, use the AI install prompt.</p>
        <div class="cta-row" style="justify-content:flex-start">
          <a class="btn btn-primary" href={`${base}install/`}>Install Zagros</a>
          <a class="btn btn-ghost" href={`${base}install-prompt/`}>AI install</a>
        </div>
      </section>

      <section class="docs-section">
        <div class="kicker">Reference</div>
        <h2>Browse by topic</h2>
        <div class="docs-topic-grid">
          {navGroups.slice(1).map((group) => (
            <div class="docs-topic">
              <h3>{group.title}</h3>
              {group.items.map((item) => (
                <a href={hrefFor(item)}>
                  <span>{item.title}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          ))}
        </div>
      </section>

      <div class="note">Looking for maintainer-only or historical material? Those documents remain available by direct URL and in the repository, but they are intentionally excluded from the primary documentation navigation so normal users do not have to sort through project-management material.</div>
    </article>
  </div>
</div>
</Base>
